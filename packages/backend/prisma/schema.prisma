generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentChannel {
  WEB
  MANUAL
  WHATSAPP
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ImageType {
  LOGO
  BANNER
}

enum SubscriptionStatus {
  TRIALING // en período de prueba
  ACTIVE // suscripción pagada al día
  PAST_DUE // pago fallido, en gracia
  CANCELED // cancelada o prueba vencida sin pago
  INCOMPLETE // checkout iniciado, sin confirmar
}

// ─── Tenant ──────────────────────────────────────────────

model Tenant {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  phone       String?
  address     String?
  logoUrl     String?
  bannerUrl   String?
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  timezone    String    @default("America/Mexico_City")
  onboardedAt DateTime?
  trialEndsAt DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Suscripción SaaS (Stripe)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?

  users              User[]
  employees          Employee[]
  services           Service[]
  schedules          Schedule[]
  appointments       Appointment[]
  privacyConsents    PrivacyConsent[]
  scheduleExceptions ScheduleException[]
  imageVersions      ImageVersion[]
}

// ─── User (Business Owner / Admin) ──────────────────────

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String   @unique
  passwordHash String?
  name         String
  role         Role     @default(OWNER)
  googleId     String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ─── Employee ───────────────────────────────────────────

model Employee {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services     EmployeeService[]
  schedules    Schedule[]
  appointments Appointment[]

  @@index([tenantId])
}

// ─── Service ────────────────────────────────────────────

model Service {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  durationMinutes Int
  bufferMinutes   Int       @default(0)
  priceMXN        Decimal   @db.Decimal(10, 2)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees    EmployeeService[]
  appointments Appointment[]
  availability ServiceAvailability[]

  @@index([tenantId])
}

// ─── Service Availability (optional day/time restrictions) ─

model ServiceAvailability {
  id        String    @id @default(cuid())
  serviceId String
  dayOfWeek DayOfWeek
  startTime String?   // HH:mm, null = all day
  endTime   String?   // HH:mm, null = all day

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dayOfWeek])
  @@index([serviceId])
}

// ─── Employee ↔ Service (many-to-many) ──────────────────

model EmployeeService {
  employeeId String
  serviceId  String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@index([serviceId])
}

// ─── Schedule (recurring weekly) ────────────────────────

model Schedule {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  dayOfWeek  DayOfWeek
  blockIndex Int       @default(0) // 0, 1, 2 — multiple blocks per day for breaks
  startTime  String    // HH:mm format (e.g. "09:00")
  endTime    String    // HH:mm format (e.g. "19:00")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek, blockIndex])
  @@index([tenantId])
}

// ─── Schedule Exception (specific date overrides) ───────

model ScheduleException {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  date       DateTime @db.Date
  startTime  String?  // null = day off
  endTime    String?  // null = day off
  reason     String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId])
}

// ─── Appointment ────────────────────────────────────────

model Appointment {
  id                 String              @id @default(cuid())
  tenantId           String
  employeeId         String
  serviceId          String
  clientName         String
  clientPhone        String
  clientEmail        String?
  startTime          DateTime
  endTime            DateTime
  status             AppointmentStatus   @default(CONFIRMED)
  channel            AppointmentChannel  @default(WEB)
  cancellationReason String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, startTime])
  @@index([tenantId, startTime])
}

// ─── Privacy Consent (LFPDPPP) ──────────────────────────

model PrivacyConsent {
  id          String   @id @default(cuid())
  tenantId    String
  clientPhone String
  clientEmail String?
  consentType String   @default("booking")
  ipAddress   String?
  acceptedAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clientPhone])
}

// ─── Image Version (upload history) ─────────────────────

model ImageVersion {
  id        String    @id @default(cuid())
  tenantId  String
  url       String
  fileSize  Int       // bytes
  imageType ImageType
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, imageType])
  @@index([tenantId, createdAt(sort: Desc)])
}
