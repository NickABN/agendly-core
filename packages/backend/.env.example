DATABASE_URL=postgresql://agendly:agendly_dev@localhost:5433/agendly
JWT_SECRET=your-jwt-secret-change-in-production  # mínimo 32 caracteres: openssl rand -hex 32.
JWT_EXPIRATION=7d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
RESEND_API_KEY=your-resend-api-key
FRONTEND_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001
# FRONTEND_URL is the backend CORS/auth redirect origin.
# PUBLIC_APP_URL is the customer-facing booking/email base URL.
